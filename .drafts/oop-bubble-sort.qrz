from "system" use { Iterator, Console };
from Iterator use { range };
from Console use { read, write };

Extension {
	swap<T>(this Array<T>, index_1 Integer, index_2 Integer) Null {
		temporary T : this[index_1];
		this[index_1]: this[index_2];
		this[index_2]: temporary;
	}

	bubble_sort(this Array<Number>) Null {
		for (index_1 Integer in range(0, this.length)) {
			for (index_2 Integer in range(index_1 + 1, this.length)) {
				if (this[index_1] > this[index_2]) this.swap(index_1, index_2);
			}
		}
	}
}

Developer {
	main() Null {
		array Array<Number> : read("Enter the numbers.").split(", ").map((part) return part to Number);
		write(array);
		array.bubble_sort();
		write(array);
	}
}
